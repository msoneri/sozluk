---
---

<html lang="tr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Sözlük Arama — Neo-Brutalism</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
			rel="stylesheet"
		/>
		<style is:global>
			:root {
				--paper: #f3ecdd;
				--paper-2: #fbf6ec;
				--ink: #14110c;
				--accent: #ffd400;
				--accent-2: #ff5c36;
				--border: 3px solid var(--ink);
				--shadow: 6px 6px 0 var(--ink);
				--shadow-sm: 4px 4px 0 var(--ink);
			}
			* { box-sizing: border-box; }
			html, body { margin: 0; }
			body {
				font-family: "Space Grotesk", system-ui, sans-serif;
				color: var(--ink);
				background: var(--paper);
				background-image:
					linear-gradient(var(--ink) 1px, transparent 1px),
					linear-gradient(90deg, var(--ink) 1px, transparent 1px);
				background-size: 32px 32px;
				background-position: -1px -1px;
				min-height: 100vh;
				padding: clamp(18px, 4vw, 56px) 18px 90px;
				display: flex;
				justify-content: center;
				position: relative;
			}
			body::before {
				content: "";
				position: fixed;
				inset: 0;
				background: var(--paper);
				opacity: 0.86;
				z-index: 0;
				pointer-events: none;
			}

			.wrap { width: 100%; max-width: 1200px; position: relative; z-index: 1; }
			.layout {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 360px;
				gap: 28px;
				align-items: start;
			}
			.main { min-width: 0; }
			@media (max-width: 1024px) {
				.layout { grid-template-columns: 1fr; }
			}

			header {
				background: var(--accent);
				border: var(--border);
				box-shadow: var(--shadow);
				padding: 22px 24px;
				margin-bottom: 26px;
				position: relative;
			}
			.kicker {
				font-family: "JetBrains Mono", monospace;
				font-weight: 700;
				font-size: 12px;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				margin: 0 0 6px;
				display: inline-block;
				background: var(--ink);
				color: var(--accent);
				padding: 4px 9px;
			}
			h1 {
				font-family: "Archivo Black", sans-serif;
				font-weight: 400;
				font-size: clamp(32px, 6.5vw, 52px);
				line-height: 0.98;
				margin: 0;
				text-transform: uppercase;
				letter-spacing: -0.01em;
			}

			.search { position: relative; margin-bottom: 18px; }
			.search-label {
				position: absolute;
				top: -12px;
				left: 16px;
				z-index: 2;
				background: var(--ink);
				color: var(--paper-2);
				font-family: "JetBrains Mono", monospace;
				font-weight: 700;
				font-size: 11px;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				padding: 3px 9px;
			}
			#query {
				width: 100%;
				font-family: "JetBrains Mono", monospace;
				font-weight: 500;
				font-size: 18px;
				color: var(--ink);
				background: var(--paper-2);
				border: var(--border);
				box-shadow: var(--shadow);
				padding: 20px;
				outline: 0;
				transition: box-shadow 0.1s, transform 0.1s, background 0.1s;
			}
			#query::placeholder { color: #9a907c; }
			#query:focus {
				background: var(--accent);
				box-shadow: 8px 8px 0 var(--ink);
				transform: translate(-2px, -2px);
			}

			.status {
				display: inline-flex;
				align-items: center;
				gap: 9px;
				margin: 2px 0 0;
				font-family: "JetBrains Mono", monospace;
				font-weight: 700;
				font-size: 13px;
				background: var(--ink);
				color: var(--paper-2);
				padding: 7px 13px;
				border: var(--border);
				box-shadow: var(--shadow-sm);
			}
			.status .tag {
				background: var(--accent);
				color: var(--ink);
				padding: 1px 7px;
			}
			.status.error { background: var(--accent-2); color: var(--ink); }
			.status.error .tag { background: var(--ink); color: var(--accent-2); }

			#results {
				list-style: none;
				margin: 22px 0 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 11px;
			}
			#results li {
				font-family: "Space Grotesk", sans-serif;
				font-weight: 600;
				font-size: 16px;
				background: var(--paper-2);
				border: var(--border);
				box-shadow: var(--shadow-sm);
				padding: 10px 15px;
				cursor: pointer;
				transition: transform 0.08s, box-shadow 0.08s, background 0.08s;
				animation: drop 0.22s cubic-bezier(0.3, 1.3, 0.5, 1) both;
			}
			#results li:hover {
				transform: translate(-2px, -2px);
				box-shadow: 6px 6px 0 var(--ink);
				background: var(--accent);
			}
			#results li mark {
				background: var(--accent-2);
				color: var(--paper-2);
				padding: 0 3px;
				font-weight: 700;
			}
			#results li:hover mark { background: var(--ink); color: var(--accent); }
			@keyframes drop {
				from { opacity: 0; transform: translate(0, -8px); }
			}

			.empty {
				margin-top: 24px;
				padding: 30px 26px;
				background: var(--paper-2);
				border: var(--border);
				box-shadow: var(--shadow);
				text-align: left;
			}
			.empty .big {
				font-family: "Archivo Black";
				font-size: 24px;
				text-transform: uppercase;
				margin-bottom: 8px;
			}
			.empty .small {
				font-family: "JetBrains Mono", monospace;
				font-size: 13px;
				color: #5c5443;
			}

			.help-aside {
				background: var(--paper-2);
				border: var(--border);
				box-shadow: var(--shadow);
				position: sticky;
				top: 20px;
			}
			.help-aside h2 {
				margin: 0;
				padding: 16px 22px;
				font-family: "Archivo Black";
				font-size: 15px;
				text-transform: uppercase;
				letter-spacing: 0.01em;
				background: var(--ink);
				color: var(--accent);
			}
			@media (max-width: 900px) {
				.help-aside { position: static; margin-top: 28px; }
			}
			.help-body { padding: 18px 22px 22px; }
			.help-body > p {
				font-family: "Space Grotesk";
				font-weight: 500;
				font-size: 14.5px;
				line-height: 1.55;
				margin: 2px 0 18px;
			}
			.table-scroll { border: var(--border); }
			table {
				width: 100%;
				border-collapse: collapse;
				font-size: 13px;
				background: var(--paper);
				table-layout: fixed;
			}
			thead th {
				text-align: left;
				font-family: "JetBrains Mono", monospace;
				font-weight: 700;
				font-size: 10.5px;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				background: var(--ink);
				color: var(--accent);
				padding: 10px 11px;
			}
			tbody td {
				padding: 10px 11px;
				border-bottom: 2px solid var(--ink);
				vertical-align: top;
				font-weight: 500;
				word-break: break-word;
			}
			tbody tr:last-child td { border-bottom: 0; }
			tbody tr:nth-child(even) { background: rgba(20, 17, 12, 0.04); }
			thead th:first-child, tbody td:first-child { width: 38%; }
			tbody td:last-child { color: #5c5443; }
			thead th:last-child, tbody td:last-child { display: none; }
			@media (min-width: 1025px) {
				thead th:first-child, tbody td:first-child { width: 32%; }
				thead th:last-child, tbody td:last-child { display: table-cell; width: 30%; }
			}
			@media (max-width: 1024px) and (min-width: 640px) {
				thead th:last-child, tbody td:last-child { display: table-cell; width: 32%; }
				thead th:first-child, tbody td:first-child { width: 24%; }
			}
			code {
				font-family: "JetBrains Mono", monospace;
				font-weight: 700;
				font-size: 12px;
				background: var(--accent);
				color: var(--ink);
				padding: 2px 5px;
				border: 2px solid var(--ink);
				white-space: nowrap;
			}
			.fine {
				margin-top: 16px;
				font-family: "JetBrains Mono", monospace;
				font-size: 12px;
				color: #5c5443;
			}
		</style>
	</head>
	<body>
		<div class="wrap">
			<header>
				<span class="kicker">Regex Sözlük</span>
				<h1>Sözlük Arama</h1>
			</header>

			<div class="layout">
				<div class="main">
					<form id="searchForm" class="search" autocomplete="off">
						<span class="search-label">Ara</span>
						<input
							id="query"
							type="text"
							placeholder="regex ile ara…  örn: ^kitap"
							autofocus
						/>
					</form>

					<p id="status" class="status">
						<span class="tag" id="statusTag">·</span>
						<span id="statusText">Yükleniyor…</span>
					</p>

					<ul id="results"></ul>
					<div id="emptyState"></div>
				</div>

				<aside class="help-aside">
					<h2>Regex arama örnekleri</h2>
					<div class="help-body">
						<p>
							Aramalar regex (düzenli ifade) ile çalışır. Çoğu zaman düz
							kelime yazmak yeterli; içinde o harfler geçen kelimeleri
							bulur.
						</p>
						<div class="table-scroll">
							<table>
								<thead>
									<tr>
										<th>Kalıp</th>
										<th>Anlamı</th>
										<th>Örnek eşleşme</th>
									</tr>
								</thead>
								<tbody>
									<tr><td><code>kitap</code></td><td>içinde "kitap" geçen</td><td>kitap, kitaplık, elkitabı</td></tr>
									<tr><td><code>^kitap</code></td><td><code>^</code> = başlangıç</td><td>kitap, kitaplık</td></tr>
									<tr><td><code>lık$</code></td><td><code>$</code> = bitiş</td><td>kitaplık, akıllılık</td></tr>
									<tr><td><code>^kitap$</code></td><td>tam olarak "kitap"</td><td>kitap</td></tr>
									<tr><td><code>k.t.p</code></td><td><code>.</code> = herhangi bir harf</td><td>kitap, kutup, kâtip</td></tr>
									<tr><td><code>^k[ıi]t</code></td><td><code>[…]</code> = içindekilerden biri</td><td>kit, kıt ile başlayanlar</td></tr>
									<tr><td><code>[aeıioöuü]</code></td><td>herhangi bir sesli</td><td>(çoğu kelime)</td></tr>
									<tr><td><code>^.&#123;5&#125;$</code></td><td><code>&#123;n&#125;</code> = tam n harf</td><td>tam 5 harfli kelimeler</td></tr>
									<tr><td><code>kitap|defter</code></td><td><code>|</code> = veya</td><td>kitap veya defter geçen</td></tr>
									<tr><td><code>a+</code></td><td><code>+</code> = bir veya daha çok</td><td>a, aa, aaa…</td></tr>
								</tbody>
							</table>
						</div>
						<p class="fine">
							Büyük/küçük harf farkı önemli değildir. En fazla 200
							sonuç gösterilir. Anlam görmek için kelimeye tıkla.
						</p>
					</div>
				</aside>
			</div>
		</div>

		<script>
			const MAX_RESULTS = 200;

			const queryEl = document.getElementById("query") as HTMLInputElement;
			const statusEl = document.getElementById("status") as HTMLElement;
			const statusText = document.getElementById("statusText") as HTMLElement;
			const statusTag = document.getElementById("statusTag") as HTMLElement;
			const resultsEl = document.getElementById("results") as HTMLUListElement;
			const emptyEl = document.getElementById("emptyState") as HTMLDivElement;

			let words: string[] = [];
			let wordsNorm: string[] = [];

			function deaccent(s: string): string {
				return s.replace(/[âîûÂÎÛ]/g, (c) =>
					({ â: "a", î: "i", û: "u", Â: "A", Î: "I", Û: "U" })[c] || c,
				);
			}

			const fmt = (n: number) => n.toLocaleString("tr-TR");

			function setStatus(tag: string, text: string, isError = false) {
				statusTag.textContent = tag;
				statusText.textContent = text;
				statusEl.classList.toggle("error", isError);
			}

			function loaded() {
				setStatus(fmt(words.length), "kelime yüklendi.");
			}

			function escapeHtml(s: string): string {
				return s
					.replace(/&/g, "&amp;")
					.replace(/</g, "&lt;")
					.replace(/>/g, "&gt;");
			}

			function highlight(word: string, norm: string, re: RegExp): string {
				const globalRe = new RegExp(re.source, "gi");
				const ranges: [number, number][] = [];
				let m: RegExpExecArray | null;
				while ((m = globalRe.exec(norm)) !== null) {
					if (m[0].length === 0) {
						globalRe.lastIndex++;
						continue;
					}
					ranges.push([m.index, m.index + m[0].length]);
				}
				if (!ranges.length) return escapeHtml(word);
				let html = "";
				let cursor = 0;
				for (const [s, e] of ranges) {
					html +=
						escapeHtml(word.slice(cursor, s)) +
						`<mark>${escapeHtml(word.slice(s, e))}</mark>`;
					cursor = e;
				}
				html += escapeHtml(word.slice(cursor));
				return html;
			}

			function search() {
				const q = queryEl.value.trim();
				const url = new URL(window.location.href);
				if (q) url.searchParams.set("q", q);
				else url.searchParams.delete("q");
				history.replaceState(null, "", url.toString());
				resultsEl.innerHTML = "";
				emptyEl.innerHTML = "";
				emptyEl.className = "";
				if (!q) {
					loaded();
					return;
				}

				let re: RegExp;
				try {
					re = new RegExp(deaccent(q), "i");
				} catch (err) {
					setStatus("HATA", `geçersiz regex: ${(err as Error).message}`, true);
					return;
				}

				const matches: { word: string; norm: string }[] = [];
				for (let i = 0; i < words.length; i++) {
					if (re.test(wordsNorm[i])) {
						matches.push({ word: words[i], norm: wordsNorm[i] });
						if (matches.length >= MAX_RESULTS) break;
					}
				}
				const total = matches.length;

				if (total === 0) setStatus("0", "sonuç bulunamadı.");
				else if (total >= MAX_RESULTS)
					setStatus(String(MAX_RESULTS), "ilk sonuç gösteriliyor.");
				else setStatus(fmt(total), "sonuç.");

				if (total === 0) {
					emptyEl.className = "empty";
					emptyEl.innerHTML = `<div class="big">Eşleşme yok</div><div class="small">“${escapeHtml(q)}” kalıbına uyan kelime yok.</div>`;
					return;
				}

				const frag = document.createDocumentFragment();
				matches.forEach((m, i) => {
					const li = document.createElement("li");
					li.style.animationDelay = Math.min(i * 10, 300) + "ms";
					li.dataset.word = m.word;
					li.innerHTML = highlight(m.word, m.norm, re);
					frag.appendChild(li);
				});
				resultsEl.appendChild(frag);
			}

			resultsEl.addEventListener("click", (e) => {
				const target = e.target as HTMLElement;
				const li = target.closest("li") as HTMLLIElement | null;
				if (!li || !li.dataset.word) return;
				const params = new URLSearchParams({ w: li.dataset.word });
				const back = queryEl.value.trim();
				if (back) params.set("back", back);
				window.location.href = `/kelime/?${params.toString()}`;
			});

			async function loadWords() {
				const res = await fetch("/autocomplete.json");
				const data: { madde: string }[] = await res.json();
				words = data.map((e) => e.madde);
				wordsNorm = words.map(deaccent);
				const initial = new URLSearchParams(window.location.search).get("q");
				if (initial) {
					queryEl.value = initial;
					search();
				} else {
					loaded();
				}
			}

			queryEl.addEventListener("input", search);
			document
				.getElementById("searchForm")
				?.addEventListener("submit", (e) => e.preventDefault());

			loadWords().catch((err) => {
				setStatus("HATA", `yüklenemedi: ${err.message}`, true);
			});
		</script>
	</body>
</html>
